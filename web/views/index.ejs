<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= meta.title %></title>
    <meta name="description" content="<%= meta.description %>">
    <meta name="author" content="<%= meta.author %>">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">Poopmap Global Dataset</a>
        <nav>
            <a href="/" class="active">Početna</a>
            <a href="/datatable">Tablica podataka</a>
        </nav>
    </header>

    <main class="page">
        <section class="card downloads">
            <h2>Preuzimanje skupa podataka</h2>
            <div class="download-grid">
                <a class="button" href="/exports/poopmap.json" download>poopmap.json</a>
                <a class="button" href="/exports/poopmap.csv" download>poopmap.csv</a>
                <a class="button" href="/exports/countries.json" download>countries.json</a>
                <a class="button" href="/exports/countries.csv" download>countries.csv</a>
                <a class="button secondary" href="/schema.json">schema.json</a>
            </div>
            <p class="muted">Pretraživanje i preuzimanje filtriranih podataka nalazi se na stranici
                <a href="/datatable">Tablica podataka</a>.</p>
        </section>

        <article class="card readme">
            <%- readme %>
        </article>
    </main>
</body>
</html>
